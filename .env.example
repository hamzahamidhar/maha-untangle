# Copy to .env.local and fill in ONE option. Leave empty to run without AI
# (the local similarity engine works fine for the demo).

# --- Option A: OpenAI ---
# AI_API_KEY=sk-...
# AI_CHAT_MODEL=gpt-4o-mini
# AI_EMBED_MODEL=text-embedding-3-small

# --- Option B: Google Gemini (OpenAI-compatible endpoint, has a free tier) ---
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=...
# AI_CHAT_MODEL=gemini-2.0-flash
# AI_EMBED_MODEL=text-embedding-004

# --- Option C: Ollama on your laptop (free, offline) ---
# AI_BASE_URL=http://localhost:11434/v1
# AI_CHAT_MODEL=llama3.1
# AI_EMBED_MODEL=nomic-embed-text

# Set to false to use AI only for wording, not for similarity.
# AI_USE_EMBEDDINGS=true
